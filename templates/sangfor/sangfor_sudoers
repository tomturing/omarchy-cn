# ==============================================================================
# Sudoers 规则配置：授权用户免密执行深信服统一生命周期管理脚本
# 放置路径：/etc/sudoers.d/sangfor
# 权限：0440 root:root
# ==============================================================================

# 允许当前管理员用户免密调用 sangfor-mgr 统一入口脚本
%wheel ALL=(ALL) NOPASSWD: /usr/local/bin/sangfor-mgr *
