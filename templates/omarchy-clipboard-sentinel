#!/bin/bash
# ==============================================================================
# Omarchy Clipboard Sentinel & Mojibake Healer (综合剪贴板守护与自愈服务)
# 第一性原理设计：
# 1. 监控因 Wayland 剪贴板 offer 挂起、管道写端未关导致的死锁 (超时 3 秒熔断)
# 2. 启动并守护 wl-paste --watch omarchy-clipboard-mojibake-healer-step，
#    无死角拦截从 Windows 复制文字时因 XA_STRING (Latin-1) 导致的问号乱码 (????)
# 3. 毫秒级提取高质量 UTF-8 并广播回全桌面
# ==============================================================================

set -u

readonly TIMEOUT_LIMIT=3
readonly LOG_TAG="omarchy-clipboard-sentinel"

logger -t "$LOG_TAG" "Omarchy Clipboard Sentinel started. Monitoring stuck clipboard pipelines & mojibake."

HEALER_STEP="/home/tom/.local/bin/omarchy-clipboard-mojibake-healer-step"

# 启动纯事件驱动的剪贴板提纯看门狗 (不加 --type 限制，确保捕获所有 RDP 剪贴板事件)
start_healer() {
  if [[ -x "$HEALER_STEP" ]]; then
    wl-paste --watch "$HEALER_STEP" &
    HEALER_PID=$!
  fi
}

start_healer
trap 'kill "${HEALER_PID:-}" 2>/dev/null || true' EXIT

while true; do
  # 保证提纯监听器始终存活
  if [[ -n "${HEALER_PID:-}" ]] && ! kill -0 "$HEALER_PID" 2>/dev/null; then
    start_healer
  fi

  while read -r pid etimes comm args; do
    [[ -z "$pid" ]] && continue

    if (( etimes >= TIMEOUT_LIMIT )); then
      if [[ "$args" == *"--watch"* ]]; then
        continue
      fi

      if [[ "$comm" == "wl-paste" || "$args" == *"capture.sh"* ]]; then
        logger -t "$LOG_TAG" -p user.warn "Detected hung clipboard process PID $pid ($comm, elapsed: ${etimes}s): $args. Severing deadlock..."
        kill -9 "$pid" 2>/dev/null || true
        wl-copy --clear 2>/dev/null || true
      fi
    fi
  done < <(ps -u "$UID" -o pid=,etimes=,comm=,args= | grep -E 'wl-paste|capture\.sh' | grep -v 'grep' | grep -v 'mojibake-healer' || true)

  sleep 1
done
